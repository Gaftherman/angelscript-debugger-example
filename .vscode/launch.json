{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to AngelScript Demo",
      "type": "angelscript",
      "request": "attach",
      "host": "127.0.0.1",
      "port": 9002,
      "protocol": "dap"
    },
    {
      "name": "Launch AngelScript Demo",
      "type": "angelscript",
      "request": "launch",
      "executable": "${workspaceFolder}/build/bin/Release/angelscript-demo.exe",
      "args": ["--wait"],
      "cwd": "${workspaceFolder}",
      "host": "127.0.0.1",
      "port": 9002,
      "protocol": "dap",
      "preLaunchTask": "Build AngelScript Demo"
    }
  ]
}
