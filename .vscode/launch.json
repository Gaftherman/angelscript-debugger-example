{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Game (asdebugger)",
      "type": "angelscript",
      "request": "attach",
      "host": "127.0.0.1",
      "port": 9002,
      "protocol": "dap"
    },
    {
      "name": "Launch Game and Debug",
      "type": "angelscript",
      "request": "launch",
      "executable": "${workspaceFolder}/bin/game.exe",
      "args": [],
      "cwd": "${workspaceFolder}",
      "host": "127.0.0.1",
      "port": 9002,
      "protocol": "dap",
      "stopOnEntry": false
    }
  ]
}
